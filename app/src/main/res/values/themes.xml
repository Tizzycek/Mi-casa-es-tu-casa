<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MiCasaEsTuCasa" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colori primari -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Colori secondari -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Colori di sfondo -->
        <item name="android:colorBackground">@color/backgroundColor</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorError">@color/red</item>

        <!-- App Bar -->
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/primary_dark</item>
    </style>

    <style name="Theme.MiCasaEsTuCasa" parent="Base.Theme.MiCasaEsTuCasa" />

    <!-- Splash screen theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/primary</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MiCasaEsTuCasa</item>
    </style>
</resources>