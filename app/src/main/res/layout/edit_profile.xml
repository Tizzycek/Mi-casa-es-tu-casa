<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".ui.utente.ModificaProfilo">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Icona/Logo -->
            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/avatarInitialsTextView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/avatar_circle_background"
                    android:gravity="center"
                    android:textColor="?android:attr/colorBackground"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    tools:text="MR"/>

            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/modifica_utente"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/aggiorna_dati"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorSecondary"
                android:gravity="center"
                android:layout_marginBottom="32dp"/>

            <!-- Email (non modificabile) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/email"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="4dp"/>


            <EditText
                android:id="@+id/emailEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:enabled="false"
                android:focusable="false"
                android:clickable="false"
                android:background="@drawable/edittext_background"
                android:textColor="?android:attr/textColorSecondary"
                android:textColorHint="?android:attr/textColorHint" />


            <!-- Nuova Password (opzionale) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nuova_password_opzionale"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/nuovaPasswordEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/lascia_vuoto_per_mantenere"
                android:inputType="textPassword"
                android:maxLines="1"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/edittext_background"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorHint"/>

            <!-- Conferma Nuova Password -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/conferma_nuova_password"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/confermaPasswordEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/conferma_password"
                android:inputType="textPassword"
                android:maxLines="1"
                android:padding="12dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/edittext_background"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorHint"/>

            <!-- Separatore visivo -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:layout_marginVertical="8dp"/>

            <!-- Nome e Cognome -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/nome"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/nomeEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/nome"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:padding="12dp"
                        android:autofillHints="name"
                        android:background="@drawable/edittext_background"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textColorHint="?android:attr/textColorHint"
                        tools:text="Mario"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cognome"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/cognomeEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/cognome"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:padding="12dp"
                        android:background="@drawable/edittext_background"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textColorHint="?android:attr/textColorHint"
                        tools:text="Rossi"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Data di Nascita -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/data_nascita"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="8dp"/>

            <DatePicker
                android:id="@+id/dataNascita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:datePickerMode="spinner"
                android:calendarViewShown="false"
                android:background="@color/backgroundColor"
                android:textColor="?android:attr/textColorPrimary"/>

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:visibility="gone"
                android:indeterminateTint="@color/primary"/>

            <!-- Bottone Salva Modifiche -->
            <Button
                android:id="@+id/btnSalvaModifiche"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/primary"
                android:text="@string/salva_propriet"
                android:textSize="16sp"
                android:textColor="?android:attr/colorBackground"
                android:textAllCaps="false"
                android:padding="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"/>

            <!-- Bottone Annulla -->
            <Button
                android:id="@+id/btnAnnulla"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/light_gray"
                android:text="@string/annulla"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary"
                android:textAllCaps="false"
                android:padding="16dp"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </RelativeLayout>
</ScrollView>