<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/panoramica_prenotazioni"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="20dp"
            android:fontFamily="sans-serif-medium" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="180dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/primary"
            android:clickable="false"
            android:focusable="false"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_total_bookings"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="@string/prenotazioni_totali"
                    app:tint="#FFFFFF"
                    android:alpha="0.9" />

                <TextView
                    android:id="@+id/totalBookingsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NaN"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/prenotazioni_totali"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="8dp"
                    android:alpha="0.85"
                    android:fontFamily="sans-serif"
                    android:textAlignment="center" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_margin="6dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:clickable="false"
                android:focusable="false"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_schedule"
                        android:layout_marginBottom="12dp"
                        android:contentDescription="In Attesa"
                        app:tint="#FF9800" />

                    <TextView
                        android:id="@+id/pendingBookingsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NaN"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="?android:textColorPrimary"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/in_attesa"
                        android:textSize="14sp"
                        android:textColor="#FFA500"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_margin="6dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:clickable="false"
                android:focusable="false"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_check_circle"
                        android:layout_marginBottom="12dp"
                        android:contentDescription="Accettate"
                        app:tint="@color/emerald_green" />

                    <TextView
                        android:id="@+id/acceptedBookingsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NaN"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="?android:textColorPrimary"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/accettata"
                        android:textSize="14sp"
                        android:textColor="@color/emerald_green"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_margin="6dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:clickable="false"
                android:focusable="false"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_cancel"
                        android:layout_marginBottom="12dp"
                        android:contentDescription="Rifiutate"
                        app:tint="#F44336" />

                    <TextView
                        android:id="@+id/rejectedBookingsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NaN"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="?android:textColorPrimary"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rifiutata"
                        android:textSize="14sp"
                        android:textColor="#F31207"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_margin="6dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:clickable="false"
                android:focusable="false"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_remove_circle"
                        android:layout_marginBottom="12dp"
                        android:contentDescription="Annullate"
                        app:tint="#9E9E9E" />

                    <TextView
                        android:id="@+id/cancelledBookingsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NaN"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="?android:textColorPrimary"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/annullata"
                        android:textSize="14sp"
                        android:textColor="#9E9E9E"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </GridLayout>

    </LinearLayout>

</ScrollView>