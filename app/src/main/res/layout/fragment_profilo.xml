<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".ui.home.fragments.nonadmin.profilo.ProfiloFragment">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Header con Avatar (iniziali) -->
            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/avatarInitialsTextView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/avatar_circle_background"
                    android:gravity="center"
                    android:textColor="?android:attr/colorBackground"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    tools:text="MR"/>

                <!-- Badge (visibile condizionalmente) -->
                <ImageView
                    android:id="@+id/badgeImageView"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="bottom|end"
                    android:src="@drawable/ic_badge"
                    android:visibility="gone"
                    android:contentDescription="Badge"
                    tools:visibility="visible"/>
            </FrameLayout>

            <!-- Nome e Cognome -->
            <TextView
                android:id="@+id/nomeCognomeTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                tools:text="Mario Rossi"/>

            <!-- Media Recensioni con Stelline -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center"
                android:layout_marginBottom="8dp">

                <RatingBar
                    android:id="@+id/mediaRatingBar"
                    style="?android:attr/ratingBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:progressTint="@color/primary"
                    android:secondaryProgressTint="@color/primary"
                    android:stepSize="0.5"
                    tools:rating="4.5"/>

                <TextView
                    android:id="@+id/mediaValoreTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:layout_marginStart="8dp"
                    tools:text="4.5/5"/>
            </LinearLayout>

            <!-- Numero Recensioni -->
            <TextView
                android:id="@+id/numeroRecensioniTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:layout_marginBottom="32dp"
                tools:text="15 recensioni"/>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:layout_marginBottom="24dp"/>

            <!-- Opzione 1: Modifica Utente -->
            <LinearLayout
                android:id="@+id/modificaUtenteLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="?android:attr/selectableItemBackground"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/edit_24px"
                    app:tint="?android:attr/textColorSecondary"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="@string/modifica_utente"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/modifica_utente"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"/>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/chevron_right_24px"
                    app:tint="?android:attr/textColorHint"/>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/listDivider"/>

            <!-- Opzione 2: Visualizza Recensioni -->
            <LinearLayout
                android:id="@+id/visualizzaRecensioniLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="?android:attr/selectableItemBackground"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/star_shine_24px"
                    app:tint="?android:attr/textColorSecondary"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="@string/visualizza_recensioni"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/visualizza_recensioni"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"/>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/chevron_right_24px"
                    app:tint="?android:attr/textColorHint"/>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/listDivider"/>

            <!-- Opzione 3: Logout -->
            <LinearLayout
                android:id="@+id/logoutLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="?android:attr/selectableItemBackground"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/logout_24px"
                    app:tint="@color/red"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="@string/logout"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/logout"
                    android:textColor="@color/red"
                    android:textSize="16sp"/>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/chevron_right_24px"
                    app:tint="@color/red"/>
            </LinearLayout>

        </LinearLayout>
    </RelativeLayout>
</ScrollView>